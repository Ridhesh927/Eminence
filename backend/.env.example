NODE_ENV=development
PORT=3000

# Database Configuration:
# - Production / Staging: Provide PostgreSQL connection URL (e.g., NeonDB)
# - Local Development: Leave DATABASE_URL empty or set USE_SQLITE=true to use SQLite
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/eminence_db
USE_SQLITE=false

# Seeding Configuration:
# - Set DEMO_SEED=true to seed initial demo accounts (customers, drivers, vehicles, admin)
# - When USE_SQLITE=true and NODE_ENV=development, seeding runs automatically
DEMO_SEED=false

# Telemetry provider:
# - simulator: generated values for local demos/tests
# - mqtt: reserved for a future real-device adapter
# - none: disable telemetry until a provider is connected
TELEMETRY_PROVIDER=simulator
TELEMETRY_SIMULATION_ENABLED=false

# Redis Cache (Optional)
# - Leave empty to use in-memory LRU cache
# - For production, use a provider like Upstash (https://upstash.com) or Redis Labs
REDIS_URL=rediss://default:password@your-redis-endpoint.upstash.io:6379

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# Fast2SMS
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Google Maps
GOOGLE_MAPS_API_KEY=your_key_here

# Razorpay (Phase 2)
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# WhatsApp (Phase 2)
WHATSAPP_BUSINESS_PHONE_ID=your_phone_id
WHATSAPP_ACCESS_TOKEN=your_token

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@eminence.com
SMTP_PASS=app_password_here
SMTP_FROM=noreply@eminence.com

# CORS Configuration (Comma-separated deployed frontend origins; no localhost in production)
CORS_ORIGIN=https://your-frontend-domain.example

# Database Bootstrap (Set to true on initial deploy to create PostgreSQL tables without dropping data)
DB_SYNC=false

# Seed/Demo User
SEED_EMAIL=admin@example.com
SEED_PASSWORD=
SEED_PHONE=
SEED_DRIVER_PHONE=
SEED_OTP=
ADMIN_EMAIL=
ADMIN_PASSWORD=
OSRM_BASE_URL=https://router.project-osrm.org
SUPPORT_PHONE=
TELEMETRY_SIMULATION_VEHICLE_ID=

# Reverse Proxy Trust (1 for single reverse proxy like Render, Vercel, Nginx, or AWS ALB)
TRUST_PROXY=1

# AI Provider, Cost Control & Quota Protection (Groq)
GROQ_API_KEY=your_groq_api_key_here
AI_FEATURE_ENABLED=true
AI_DAILY_QUOTA_LIMIT=500
AI_MAX_CONCURRENT_REQUESTS=5
AI_USER_RATE_LIMIT_PER_MINUTE=10
AI_REQUEST_TIMEOUT_MS=8000
AI_TRANSCRIPTION_TIMEOUT_MS=10000

# Production rate limits (requests per 15 minutes unless noted)
RATE_LIMIT_API_MAX=100
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_BOOKING_MAX=100
RATE_LIMIT_BOOKING_CREATE_MAX=20
RATE_LIMIT_AI_BOOKING_MAX=10
RATE_LIMIT_ADDRESS_MAX=50
RATE_LIMIT_CONTACT_MAX=5
RATE_LIMIT_LOCATION_MAX=600
RATE_LIMIT_REPORT_MAX=60
RATE_LIMIT_VOICE_MAX=30
RATE_LIMIT_PAYMENT_MAX=20
RATE_LIMIT_BATCH_BOOKING_MAX=10
RATE_LIMIT_WEBHOOK_MAX=120
RATE_LIMIT_PUBLIC_READ_MAX=120

# Socket abuse controls (connection attempts per 15 minutes; location events per minute)
SOCKET_CONNECTION_MAX=30
SOCKET_LOCATION_MAX_PER_MINUTE=120
SOCKET_SOS_MAX_PER_MINUTE=3
